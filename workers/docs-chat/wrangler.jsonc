{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moshpit-docs-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCS_CHAT",
        "class_name": "DocsChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocsChatAgent"]
    }
  ]
}
